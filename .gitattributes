# 줄바꿈 문자 설정
* text=auto eol=lf

# 소스 코드 파일은 LF 사용
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 바이너리 파일은 변경하지 않음
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.jar binary

# 설정 파일
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
