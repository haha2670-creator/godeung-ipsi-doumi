# 환경 설정
NODE_ENV=development
PORT=4000

# 데이터베이스
DATABASE_URL="postgresql://postgres:password@localhost:5432/admission_toolkit?schema=public"

# Redis (선택)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key-here"

# 공공데이터포털 (한국대학교육협의회 대학알리미 API)
# 활용신청: https://www.data.go.kr/data/15037507/openapi.do
DATA_GO_KR_SERVICE_KEY=""

# AWS S3 (선택 - 파일 업로드용)
AWS_REGION="ap-northeast-2"
AWS_S3_BUCKET="admission-toolkit"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# CORS
CORS_ORIGIN="http://localhost:3000"

# Email (선택 - SendGrid)
SENDGRID_API_KEY=""
FROM_EMAIL="noreply@admission-toolkit.com"

# SMS (선택 - Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
